# The pilot form (app/api/pilot/route.ts) emails each request through Resend.
# Copy to .env.local for `npm run dev`; on your host, set the same names in its settings.

# Resend > API Keys (sending access is enough). Required: without it the form says it couldn't send.
RESEND_API_KEY=

# Where requests go.
PILOT_TO=doppelhq@gmail.com

# The sender. onboarding@resend.dev works only for sending to the address your Resend account
# was created with; once doppelai.co is verified in Resend (Domains), use your own, for example
# "Doppel website <pilot@doppelai.co>".
PILOT_FROM=Doppel website <onboarding@resend.dev>
